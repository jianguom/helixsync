# syntax=docker/dockerfile:1
# All-in-one image: the Rust API server and the built web dashboard behind
# nginx in a single container. Built from the repository root (context: .).
#
# The two-image split (server/Dockerfile + web/Dockerfile) stays preferable for
# production: it runs the backend unprivileged and lets you replace or scale
# nginx independently. This image suits small/self-hosted installs that would
# rather pull one image; both processes run as root here because nginx has to
# bind :80. Postgres is still an external dependency.
#
# The dashboard is compiled with same-origin relative API paths, so nginx
# proxies /api/ to the backend on 127.0.0.1:8080 inside this container.
FROM rust:1-slim-bookworm@sha256:a24e292b4af7bdee351a31d3a6379972a5652f0ea22a1b6d6883324ac4f5097c AS server-builder

WORKDIR /build

# Cache dependency compilation separately from application source.
COPY server/Cargo.toml server/Cargo.lock ./
RUN mkdir -p src && echo "fn main() {}" > src/main.rs && echo "" > src/lib.rs \
    && cargo build --release --locked || true

COPY server/ .
# SQLX_OFFLINE keeps the build from needing a live database; the committed
# server/.sqlx/ query cache is used instead.
ENV SQLX_OFFLINE=true
RUN touch src/main.rs src/lib.rs && cargo build --release --locked

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS web-builder

WORKDIR /build

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ .
RUN npm run build

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl nginx supervisor \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default

WORKDIR /app
COPY --from=server-builder /build/target/release/helixsync-server /app/helixsync-server
COPY --from=server-builder /build/migrations /app/migrations
COPY --from=web-builder /build/dist /usr/share/nginx/html
COPY web/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY docker/nginx-all-in-one.conf /etc/nginx/conf.d/default.conf
COPY docker/supervisord.conf /etc/supervisor/conf.d/helixsync.conf
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Fail the build on a broken nginx config instead of finding out at runtime.
RUN nginx -t

# The binary defaults to loopback; inside the container it must listen on the
# container interface so nginx can reach it.
ENV BIND_ADDR=0.0.0.0:8080
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://127.0.0.1:8080/readyz && curl -sf http://127.0.0.1/ >/dev/null || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
